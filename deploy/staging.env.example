# Copy to deploy/staging.env and replace BOTH secrets. Never commit that file.
# A URL-safe hexadecimal password avoids escaping in DATABASE_URL.
POSTGRES_PASSWORD=replace_with_32_or_more_random_hex_characters
PROJECT_DB_NAME=medknowledge_stage
LLM_BASE_URL=https://your-openai-compatible-provider.example/v1
LLM_API_KEY=replace-with-real-provider-key
CUSTOMER_MODEL=replace-with-a-supported-chat-model
EMBEDDING_MODEL=replace-with-a-supported-embedding-model
EMBEDDING_DIMENSIONS=1536
# Exact browser origin; change to https://your-domain.example for TLS.
CORS_ORIGINS=http://127.0.0.1:8090
AUTH_COOKIE_SECURE=false
# Default off. Only for a loopback HTTP demo, never for a real deployment.
LOCAL_DEMO_ALLOW_SELF_APPROVAL=false
HTTP_PORT=8090
RELEASE_TAG=recruitment-20261027
# On an HTTPS deployment, set AUTH_COOKIE_SECURE=true and match CORS_ORIGINS.
HTTPS_BIND=127.0.0.1
HTTPS_PORT=8443
# Keep measured limits explicit; tune after load tests.
CHAT_REQUESTS_PER_MINUTE=30
CHAT_GLOBAL_CONCURRENCY=20
CHAT_USER_CONCURRENCY=2
CHAT_DAILY_TOKEN_LIMIT=100000
CHAT_MONTHLY_TOKEN_LIMIT=1000000
CHAT_MAX_PROMPT_TOKENS=12000
CHAT_MAX_OUTPUT_TOKENS=2048
