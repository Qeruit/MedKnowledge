# Copy selected values into .env.local. Docker container must be the SAME DB server.
BACKUP_PG_CONTAINER=pgvector2
BACKUP_INTERVAL_HOURS=24
BACKUP_RETRY_SECONDS=3600
BACKUP_KEEP_COUNT=7
BACKUP_LOCK_TIMEOUT_SECONDS=120
STORAGE_LOCK_TIMEOUT_SECONDS=5
MONITOR_INTERVAL_SECONDS=15
MONITOR_WINDOW_SECONDS=300
ALERT_HOLD_SECONDS=30
ALERT_QUEUE_AGE_SECONDS=600
ALERT_MODEL_MIN_CALLS=3
ALERT_MODEL_ERROR_RATIO=0.5
