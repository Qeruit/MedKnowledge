DATABASE_URL=postgresql+psycopg://postgres:change-me@127.0.0.1:5432/postgres
PROJECT_DB_NAME=agent_customer_service
LLM_BASE_URL=https://your-provider.example/v1
LLM_API_KEY=replace-me
CHAT_MODEL=deepseek-v3
ALLOWED_CHAT_MODELS=deepseek-v3,deepseek-r1
CUSTOMER_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1536
# Chat admission is PostgreSQL-backed and shared by all API processes.
CHAT_REQUESTS_PER_MINUTE=30
CHAT_GLOBAL_CONCURRENCY=20
CHAT_USER_CONCURRENCY=2
CHAT_DAILY_TOKEN_LIMIT=100000
CHAT_MONTHLY_TOKEN_LIMIT=1000000
CHAT_MAX_PROMPT_TOKENS=12000
CHAT_MAX_OUTPUT_TOKENS=2048
# Set your provider's current price per million tokens, in one chosen currency.
# Zero means cost reporting is unconfigured, not that the provider is free.
CHAT_INPUT_COST_PER_MILLION=0
CHAT_OUTPUT_COST_PER_MILLION=0
EMBEDDING_COST_PER_MILLION=0
SEARXNG_URL=
MD_STORAGE_PATH=./storage/md
CORS_ORIGINS=http://localhost:5174
ADMIN_TOKEN=replace-with-a-long-random-secret
