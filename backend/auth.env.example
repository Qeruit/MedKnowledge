# Copy selected values into .env.local. HTTPS production MUST use true.
AUTH_COOKIE_SECURE=false
AUTH_SESSION_HOURS=12
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
# Optional for operator smoke tests after changing the bootstrap password.
# AUTH_TEST_USERNAME=admin
# AUTH_TEST_PASSWORD=provide-locally-never-commit
